{
  "config_version": "5.0",
  "experiment": "concise-causal-findings-v5",
  "system_prompt": "evaluation/prompts/sre_system_v5.md",
  "task_prompt": "evaluation/prompts/sre_diagnosis_v5.md",
  "output_schema": "evaluation/schemas/diagnosis-v3.schema.json",
